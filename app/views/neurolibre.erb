    /* The stars sit behind the band's content and never affect layout. */
    #stars, #stars2, #stars3 {
      position: absolute;
      top: 0; left: 0;
      background: transparent;
      pointer-events: none;
    }
    /* Round rather than square, and tinted from the page's paper palette so
       they read as warm motes rather than clinical white pixels. */
    #stars, #stars2, #stars3,
    #stars::after, #stars2::after, #stars3::after,
    #hstars, #hstars2, #hstars3,
    #hstars::after, #hstars2::after, #hstars3::after { border-radius: 50%; }
    #stars  { width: 1px; height: 1px; box-shadow: var(--stars-1); animation: animStar 50s  linear infinite; }
    #stars2 { width: 2px; height: 2px; box-shadow: var(--stars-2); animation: animStar 100s linear infinite; }
    #stars3 { width: 3px; height: 3px; box-shadow: var(--stars-3); animation: animStar 150s linear infinite; }

    #stars::after, #stars2::after, #stars3::after {
      content: " ";
      position: absolute;
      top: 2000px;
      background: transparent;
    }
    #stars::after  { width: 1px; height: 1px; box-shadow: var(--stars-1); }
    #stars2::after { width: 2px; height: 2px; box-shadow: var(--stars-2); }
    #stars3::after { width: 3px; height: 3px; box-shadow: var(--stars-3); }

    @keyframes animStar {
      from { transform: translateY(0); }
      to   { transform: translateY(-2000px); }
    }

    .band-inner { position: relative; z-index: 1; }

    /* ---- Neon checkbox, from Uiverse.io by 00Kubi ---- */
    .neon-checkbox {
      /* Matched to the toggle's green so the band has one accent, not two. */
      --primary: #72eb67;
      --primary-dark: #4cc142;
      --primary-light: #a9f0a2;
      --size: 26px;
      position: relative;
      flex: none;
      width: var(--size);
      height: var(--size);
      margin: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    /* Deviation from the original, which used `display: none`. A required
       control that is display:none is unfocusable, which both breaks keyboard
       use and makes the browser refuse to submit the form outright. */
    .neon-checkbox input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      opacity: 0;
      cursor: pointer;
    }

    .neon-checkbox__frame { position: relative; width: 100%; height: 100%; pointer-events: none; }

    .neon-checkbox__box {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      border-radius: 4px;
      border: 2px solid var(--primary-dark);
      transition: all 0.4s ease;
    }

    .neon-checkbox__check-container {
      position: absolute;
      inset: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .neon-checkbox__check {
      width: 80%;
      height: 80%;
      fill: none;
      stroke: var(--primary);
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 40;
      stroke-dashoffset: 40;
      transform-origin: center;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .neon-checkbox__glow {
      position: absolute;
      inset: -2px;
      border-radius: 6px;
      background: var(--primary);
      opacity: 0;
      filter: blur(8px);
      transform: scale(1.2);
      transition: all 0.4s ease;
    }

    .neon-checkbox__borders {
      position: absolute;
      inset: 0;
      border-radius: 4px;
      overflow: hidden;
    }
    .neon-checkbox__borders span {
      position: absolute;
      width: 40px;
      height: 1px;
      background: var(--primary);
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .neon-checkbox__borders span:nth-child(1) { top: 0; left: -100%; animation: borderFlow1 2s linear infinite; }
    .neon-checkbox__borders span:nth-child(2) { top: -100%; right: 0; width: 1px; height: 40px; animation: borderFlow2 2s linear infinite; }
    .neon-checkbox__borders span:nth-child(3) { bottom: 0; right: -100%; animation: borderFlow3 2s linear infinite; }
    .neon-checkbox__borders span:nth-child(4) { bottom: -100%; left: 0; width: 1px; height: 40px; animation: borderFlow4 2s linear infinite; }

    .neon-checkbox__particles span {
      position: absolute;
      width: 4px; height: 4px;
      background: var(--pc, var(--primary));
      border-radius: 50%;
      opacity: 0;
      pointer-events: none;
      top: 50%; left: 50%;
      box-shadow: 0 0 6px var(--pc, var(--primary));
    }

    .neon-checkbox__rings { position: absolute; inset: -20px; pointer-events: none; }
    .neon-checkbox__rings .ring {
      position: absolute; inset: 0;
      border-radius: 50%;
      border: 1px solid var(--primary);
      opacity: 0;
      transform: scale(0);
    }

    .neon-checkbox__sparks span {
      position: absolute;
      width: 20px; height: 1px;
      background: linear-gradient(90deg, var(--primary), transparent);
      opacity: 0;
    }

    .neon-checkbox:hover .neon-checkbox__box { border-color: var(--primary); transform: scale(1.05); }

    .neon-checkbox input:focus-visible ~ .neon-checkbox__frame .neon-checkbox__box {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }

    .neon-checkbox input:checked ~ .neon-checkbox__frame .neon-checkbox__box {
      border-color: var(--primary);
      background: rgba(114, 235, 103, 0.12);
    }
    .neon-checkbox input:checked ~ .neon-checkbox__frame .neon-checkbox__check {
      stroke-dashoffset: 0;
      transform: scale(1.1);
    }
    .neon-checkbox input:checked ~ .neon-checkbox__frame .neon-checkbox__glow { opacity: 0.2; }
    .neon-checkbox input:checked ~ .neon-checkbox__frame .neon-checkbox__borders span { opacity: 1; }
    .neon-checkbox input:checked ~ .neon-checkbox__frame .neon-checkbox__particles span { animation: particleExplosion 0.6s ease-out forwards; }
    .neon-checkbox input:checked ~ .neon-checkbox__frame .neon-checkbox__rings .ring { animation: ringPulse 0.6s ease-out forwards; }
    .neon-checkbox input:checked ~ .neon-checkbox__frame .neon-checkbox__sparks span { animation: sparkFlash 0.6s ease-out forwards; }

    @keyframes borderFlow1 { 0% { transform: translateX(0); } 100% { transform: translateX(200%); } }
    @keyframes borderFlow2 { 0% { transform: translateY(0); } 100% { transform: translateY(200%); } }
    @keyframes borderFlow3 { 0% { transform: translateX(0); } 100% { transform: translateX(-200%); } }
    @keyframes borderFlow4 { 0% { transform: translateY(0); } 100% { transform: translateY(-200%); } }

    @keyframes particleExplosion {
      0%   { transform: translate(-50%, -50%) scale(1); opacity: 0; }
      20%  { opacity: 1; }
      100% { transform: translate(calc(-50% + var(--x, 20px)), calc(-50% + var(--y, 20px))) scale(0); opacity: 0; }
    }
    @keyframes ringPulse {
      0%   { transform: scale(0); opacity: 1; }
      100% { transform: scale(2); opacity: 0; }
    }
    @keyframes sparkFlash {
      0%   { transform: rotate(var(--r, 0deg)) translateX(0) scale(1); opacity: 1; }
      100% { transform: rotate(var(--r, 0deg)) translateX(30px) scale(0); opacity: 0; }
    }

    .neon-checkbox__particles span:nth-child(1)  { --x: 25px;  --y: -25px; --pc: #ff6ec7; }
    .neon-checkbox__particles span:nth-child(2)  { --x: -25px; --y: -25px; --pc: #b06cff; }
    .neon-checkbox__particles span:nth-child(3)  { --x: 25px;  --y: 25px; --pc: #ffd166; }
    .neon-checkbox__particles span:nth-child(4)  { --x: -25px; --y: 25px; --pc: #72eb67; }
    .neon-checkbox__particles span:nth-child(5)  { --x: 35px;  --y: 0px; --pc: #ff6ec7; }
    .neon-checkbox__particles span:nth-child(6)  { --x: -35px; --y: 0px; --pc: #b06cff; }
    .neon-checkbox__particles span:nth-child(7)  { --x: 0px;   --y: 35px; --pc: #ffd166; }
    .neon-checkbox__particles span:nth-child(8)  { --x: 0px;   --y: -35px; --pc: #72eb67; }
    .neon-checkbox__particles span:nth-child(9)  { --x: 20px;  --y: -30px; --pc: #ff6ec7; }
    .neon-checkbox__particles span:nth-child(10) { --x: -20px; --y: 30px; --pc: #b06cff; }
    .neon-checkbox__particles span:nth-child(11) { --x: 30px;  --y: 20px; --pc: #ffd166; }
    .neon-checkbox__particles span:nth-child(12) { --x: -30px; --y: -20px; --pc: #72eb67; }

    .neon-checkbox__sparks span:nth-child(1) { --r: 0deg;   top: 50%; left: 50%; }
    .neon-checkbox__sparks span:nth-child(2) { --r: 90deg;  top: 50%; left: 50%; }
    .neon-checkbox__sparks span:nth-child(3) { --r: 180deg; top: 50%; left: 50%; }
    .neon-checkbox__sparks span:nth-child(4) { --r: 270deg; top: 50%; left: 50%; }

    .neon-checkbox__rings .ring:nth-child(1) { animation-delay: 0s; }
    .neon-checkbox__rings .ring:nth-child(2) { animation-delay: 0.1s; }
    .neon-checkbox__rings .ring:nth-child(3) { animation-delay: 0.2s; }

    /* Gate rows now hold the box and its text side by side. */
    .gate-row {
      display: flex; align-items: center; gap: .85rem;
      margin-bottom: 1rem; text-align: left;
      max-width: 34rem; margin-left: auto; margin-right: auto;
    }
    .gate-row:last-of-type { margin-bottom: 0; }
    .gate-text {
      display: block;
      margin: 0; font-size: .9rem; letter-spacing: 0; line-height: 1.5;
      color: rgba(255,255,255,.92); cursor: pointer;
    }
    /* Keep the chip on the same line as its surrounding words. */
    .gate-text code { white-space: nowrap; }

    /* Revealed when the runtime box is ticked. Animating grid-template-rows
       from 0fr to 1fr gives a true height transition without measuring. */
    .gate-hint {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      margin-left: calc(26px + .85rem);
      transition: grid-template-rows .4s cubic-bezier(.22,.61,.36,1),
                  opacity .3s ease,
                  margin-top .4s cubic-bezier(.22,.61,.36,1);
    }
    .gate-hint.show { grid-template-rows: 1fr; opacity: 1; margin-top: .7rem; }
    .gate-hint > p {
      overflow: hidden;
      margin: 0;
      padding-left: .9rem;
      border-left: 2px solid #72eb67;
      text-align: left;
      font-family: var(--serif);
      font-size: .88rem;
      font-style: italic;
      line-height: 1.5;
      color: rgba(255,255,255,.72);
    }
    @media (prefers-reduced-motion: reduce) {
      .gate-hint { transition: none; }
    }

    /* ---- Hero band ---- */
    /* Dimmer than the runtime band on purpose: the mark is drawn red on
       transparent for light grounds, so a bright red field swallows it. */
    .hero-band {
      position: relative;
      left: 50%; right: 50%;
      margin-left: -50vw; margin-right: -50vw;
      width: 100vw;
      margin-top: -1.5rem;
      margin-bottom: 3rem;
      padding: 1.5rem 1.5rem 1.25rem;
      background: #091926;
      opacity: .9;
      overflow: hidden;
      border: 0;
    }
    .hero-inner { position: relative; z-index: 1; max-width: 44rem; margin: 0 auto; }
    /* Sits a little left of centre. Offset via margin rather than transform,
       because .rise animates transform and would cancel it out. */
    .hero-band .mark { width: 85%; max-width: 85%; margin: 0 auto 0 0; }

    #hstars, #hstars2, #hstars3 {
      position: absolute; top: 0; left: 0;
      background: transparent; pointer-events: none;
    }
    #hstars  { width: 2px; height: 2px; box-shadow: var(--stars-1); animation: animStar 50s  linear infinite; }
    #hstars2 { width: 3px; height: 3px; box-shadow: var(--stars-2); animation: animStar 100s linear infinite; }
    #hstars3 { width: 5px; height: 5px; box-shadow: var(--stars-3); animation: animStar 150s linear infinite; }
    #hstars::after, #hstars2::after, #hstars3::after {
      content: " "; position: absolute; top: 2000px; background: transparent;
    }
    #hstars::after  { width: 2px; height: 2px; box-shadow: var(--stars-1); }
    #hstars2::after { width: 3px; height: 3px; box-shadow: var(--stars-2); }
    #hstars3::after { width: 5px; height: 5px; box-shadow: var(--stars-3); }

    /* Full bleed band. Breaks out of the centred column to span the viewport. */
    .runtime-band {
      position: relative;
      left: 50%; right: 50%;
      margin-left: -50vw; margin-right: -50vw;
      width: 100vw;
      padding: 3.25rem 1.5rem;
      background: #091926;
      opacity: .9;
      overflow: hidden;
      text-align: center;
      border: 0;
      margin-top: 3.5rem; margin-bottom: 2.5rem;
    }
    .band-label {
      margin: 0 0 3rem; padding: 0;
      font-family: var(--serif);
      font-size: clamp(1.25rem, 2.6vw, 1.6rem);
      letter-spacing: .12em; text-transform: uppercase;
      color: rgba(255,255,255,.92);
    }
    .runtime-band .switch { margin: 0 auto; }

    .toggle-state {
      margin: 1.5rem auto 0;
      max-width: 30rem;
      font-size: .95rem;
      color: rgba(255,255,255,.85);
      transition: color .3s ease;
    }
    .toggle-state.on { color: #a9f0a2; }

    /* Terrarium confirmation, revealed only when a runtime is required. */
    .terrarium {
      max-width: 34rem;
      margin: 1.75rem auto 0;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255,255,255,.12);
      display: none;
    }
    .terrarium.show { display: block; }
    /* Deliberately no `.terrarium label` rule: it would also catch .gate-text
       and .neon-checkbox, and a flex label breaks its own text into items. */
    .terrarium input[type="checkbox"] {
      flex: none; width: 1.05rem; height: 1.05rem; margin-top: .15rem;
      accent-color: var(--accent); cursor: pointer;
    }
    .terrarium label:last-of-type { margin-bottom: 0; }
    .terrarium code {
      background: rgba(255,255,255,.16);
      padding: 0 .3rem; border-radius: 3px;
      font-family: var(--mono); font-size: .85em;
    }
    .terrarium a {
      color: #fff;
      background-image: linear-gradient(#fff, #fff);
      background-size: 100% 1px;
    }
    .terrarium a:hover { color: #ffd9da; background-image: linear-gradient(#ffd9da, #ffd9da); }

    .gate-note {
      margin: .9rem auto 0; max-width: 34rem;
      font-size: .82rem; color: rgba(255,255,255,.75);
    }

    .actions { margin-top: 2.5rem; text-align: center; }
    /* Button adapted from Uiverse.io by MuhammadHasann, recoloured to the
       NeuroLibre reds. Scoped to .btn so it cannot leak onto other buttons. */
    .btn {
      position: relative;
      display: inline-block;
      padding: 21px 64px;
      background: var(--accent);
      font-family: var(--sans);
      font-size: 20px;
      font-weight: 500;
      color: #fff;
      cursor: pointer;
      border: 1px solid var(--accent);
      border-radius: 8px;
      filter: drop-shadow(2px 2px 3px rgba(0, 0, 0, 0.2));
      overflow: visible;
    }

    .btn:not([disabled]):hover {
      border: 1px solid var(--accent-lift);
      background: linear-gradient(85deg, #c1272d, #cb2f35, #d8383e, #c62a30, #b32128);
      background-size: 200% 200%;
      animation: wind 2s ease-in-out infinite;
    }

    @keyframes wind {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* The sprigs. Their paths carry no fill, so it is set here. */
    .btn .icon-1 .fil0, .btn .icon-2 .fil0, .btn .icon-3 .fil0 { fill: #000; }

    .btn .icon-1 {
      position: absolute;
      top: 0; right: 0;
      width: 32px;
      transform-origin: 0 0;
      transform: rotate(10deg);
      transition: all 0.5s ease-in-out;
      filter: drop-shadow(2px 2px 3px rgba(0, 0, 0, 0.3));
    }
    .btn:not([disabled]):hover .icon-1 {
      animation: slay-1 3s cubic-bezier(0.52, 0, 0.58, 1) infinite;
      transform: rotate(10deg);
    }
    @keyframes slay-1 {
      0%   { transform: rotate(10deg); }
      50%  { transform: rotate(-5deg); }
      100% { transform: rotate(10deg); }
    }

    .btn .icon-2 {
      position: absolute;
      top: 0; left: 32px;
      width: 15px;
      transform-origin: 50% 0;
      transform: rotate(10deg);
      transition: all 1s ease-in-out;
      filter: drop-shadow(2px 2px 3px rgba(0, 0, 0, 0.5));
    }
    .btn:not([disabled]):hover .icon-2 {
      animation: slay-2 3s cubic-bezier(0.52, 0, 0.58, 1) 1s infinite;
      transform: rotate(0);
    }
    @keyframes slay-2 {
      0%   { transform: rotate(0deg); }
      50%  { transform: rotate(15deg); }
      100% { transform: rotate(0); }
    }

    .btn .icon-3 {
      position: absolute;
      top: 0; left: 0;
      width: 23px;
      transform-origin: 50% 0;
      transform: rotate(-5deg);
      transition: all 1s ease-in-out;
      filter: drop-shadow(2px 2px 3px rgba(0, 0, 0, 0.5));
    }
    .btn:not([disabled]):hover .icon-3 {
      animation: slay-3 2s cubic-bezier(0.52, 0, 0.58, 1) 1s infinite;
      transform: rotate(0);
    }
    @keyframes slay-3 {
      0%   { transform: rotate(0deg); }
      50%  { transform: rotate(-5deg); }
      100% { transform: rotate(0); }
    }

    /* Disabled: flat, no sprigs, no motion. */
    .btn[disabled] {
      background: #ded9d2;
      border-color: #ded9d2;
      color: #fffdfa;
      cursor: not-allowed;
      filter: none;
    }
    .btn[disabled] .icon-1,
    .btn[disabled] .icon-2,
    .btn[disabled] .icon-3 { opacity: .25; filter: none; }

    @media (prefers-reduced-motion: reduce) {
      .btn, .btn .icon-1, .btn .icon-2, .btn .icon-3 { animation: none !important; }
    }

    footer { margin-top: 4rem; text-align: center; font-size: .85rem; color: var(--muted); }
  </style>
