  <script>
    document.getElementById('preview-form').addEventListener('submit', function() {
      const branchInput = document.getElementById('branch');
      if (!branchInput.disabled && !branchInput.value) {
        branchInput.value = 'latest';
      }
    });

    // Runtime is a checkbox. A hidden input ahead of it carries the unchecked
    // value, so the posted `journal` is still True or False.
    const executable = document.getElementById('nlnb');
    const branchInput = document.getElementById('branch');
    const branchLabel = document.querySelector('label[for="branch"]');
    const stateText = document.getElementById('journal-state');
    const gate = document.getElementById('terrarium-gate');
    const gateBoxes = [
      document.getElementById('binder-folder'),
      document.getElementById('terrarium-built')
    ];
    const gateNote = document.getElementById('gate-note');
    const submitBtn = document.querySelector('#preview-form button[type="submit"]');

    function syncExecutable() {
      const on = executable.checked;

      branchInput.disabled = !on;
      branchInput.required = on;
      branchLabel.classList.toggle('required', on);
      if (!on) { branchInput.value = ''; }

      stateText.textContent = on
        ? 'My preprint needs a custom runtime environment'
        : 'My preprint does not need a custom runtime environment';
      stateText.classList.toggle('on', on);

      gate.classList.toggle('show', on);
      // `required` is only set while the controls are visible. A required
      // control that is display:none makes the browser refuse to submit at all.
      gateBoxes.forEach(box => {
        box.required = on;
        if (!on) { box.checked = false; }
      });

      syncGate();
    }

    const terrariumBox  = document.getElementById('terrarium-built');
    const terrariumHint = document.getElementById('terrarium-hint');

    function syncGate() {
      terrariumHint.classList.toggle('show', terrariumBox.checked);

      const remaining = gateBoxes.filter(box => !box.checked).length;
      const blocked = executable.checked && remaining > 0;

      submitBtn.disabled = blocked;
      gateNote.textContent = blocked
        ? (remaining > 1 ? 'Confirm both to enable the build.'
                         : 'One left to confirm.')
        : 'Ready to build.';
    }

    executable.addEventListener('change', syncExecutable);
    gateBoxes.forEach(box => box.addEventListener('change', syncGate));
    syncExecutable();

    // Reveal each checklist step as it scrolls into view.
    const steps = document.querySelectorAll('.checklist li');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      steps.forEach(step => step.classList.add('in'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -18% 0px', threshold: 0.35 });

      steps.forEach(step => observer.observe(step));
    }
  </script>
