<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RoboNeuro preview page</title>


  <style>
    :root {
      --paper:      #fbfaf7;
      --paper-warm: #f5f2ec;
      --ink:        #17171a;
      --ink-soft:   #3d3d44;
      --muted:      #71707a;
      --rule:       #e6e2da;
      --accent:     #c1272d;
      --accent-lift:#d8383e;
      --accent-wash:#fdecec;
      --leaf:       #4a7c4e;
      --danger:     #9b3b3b;
      --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
      --sans:  ui-sans-serif, system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --mono:  ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    }

    * { box-sizing: border-box; }

    html { -webkit-text-size-adjust: 100%; }

    body {
      margin: 0;
      background: var(--paper);
      /* Two very soft washes so the page is not a flat slab of white. */
      background-image:
        radial-gradient(60rem 40rem at 12% -10%, #fbf0ef 0%, rgba(251,240,239,0) 60%),
        radial-gradient(50rem 36rem at 105% 8%, var(--paper-warm) 0%, rgba(245,242,236,0) 55%);
      background-attachment: fixed;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .page { width: 100%; max-width: 44rem; margin: 0 auto; padding: 1.5rem 1.5rem 5rem; }

    /* ---- Entrance: a short staggered settle, nothing bouncy ---- */
    .rise { opacity: 0; transform: translateY(0.75rem); animation: rise .7s cubic-bezier(.22,.61,.36,1) forwards; }
    .d1 { animation-delay: .05s } .d2 { animation-delay: .13s } .d3 { animation-delay: .21s }
    .d4 { animation-delay: .29s } .d5 { animation-delay: .37s } .d6 { animation-delay: .45s }
    @keyframes rise { to { opacity: 1; transform: none; } }

    @media (prefers-reduced-motion: reduce) {
      .rise { animation: none; opacity: 1; transform: none; }
      * { transition: none !important; }
    }

    /* ---- Masthead ---- */
    .mark {
      width: 90%; max-width: 90%; height: auto; display: block; margin: 0 0 2.25rem;
      /* Holds the hero's height even if the image is slow or fails. */
      aspect-ratio: 807 / 429;
    }
    img { max-width: 100%; }

    h1 {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(2.4rem, 6vw, 3.6rem);
      line-height: 1.08;
      letter-spacing: -0.015em;
      margin: 0 0 1rem;
    }
    h1 em { font-style: italic; color: var(--accent); }

    .standfirst {
      font-family: var(--serif);
      font-size: clamp(1.05rem, 2.2vw, 1.2rem);
      color: var(--ink-soft);
      margin: 0 0 2.5rem;
      max-width: 34rem;
    }

    .rule { height: 1px; background: var(--rule); border: 0; margin: 2.75rem 0; }
    .checklist { margin-bottom: 3rem; }

    /* ---- Links: underline grows on hover ---- */
    a {
      color: var(--accent);
      text-decoration: none;
      background-image: linear-gradient(var(--accent), var(--accent));
      background-size: 0% 1px;
      background-repeat: no-repeat;
      background-position: 0 100%;
      transition: background-size .25s ease;
      padding-bottom: 1px;
    }
    a:hover, a:focus-visible { background-size: 100% 1px; }

    /* ---- Preflight checklist ---- */
    .section-label {
      margin-top: 1rem;
      font-size: .72rem; letter-spacing: .14em; text-transform: uppercase;
      color: var(--muted); margin: 0 0 1.25rem;
    }

    .checklist { list-style: none; margin: 0; padding: 0; counter-reset: step; }
    .checklist li {
      counter-increment: step;
      position: relative;
      padding: 0 0 2.25rem 3.25rem;
      color: var(--ink-soft);
      /* Scroll driven: each step settles as it comes into view. */
      opacity: .25;
      transform: translateY(0.9rem);
      transition: opacity .6s ease, transform .6s cubic-bezier(.22,.61,.36,1);
    }
    .checklist li:last-child { padding-bottom: 0; }
    .checklist li.in { opacity: 1; transform: none; }

    .checklist li::before {
      content: counter(step);
      position: absolute; left: 0; top: -.15rem;
      width: 2.1rem; height: 2.1rem;
      display: grid; place-items: center;
      border: 1px solid var(--rule);
      /* Same leaf silhouette as the toggle's knob. */
      border-radius: 1rem 0rem 1rem;
      /* A pocket of the same night sky as the bands, with its own few stars.
         Painted as gradients because box-shadow stars would fall outside. */
      background-color: rgba(9, 25, 38, .9);
      background-image:
        radial-gradient(1.5px 1.5px at 22% 26%, #fbfaf7 50%, transparent 50%),
        radial-gradient(1.5px 1.5px at 74% 20%, #ff6ec7 50%, transparent 50%),
        radial-gradient(1.5px 1.5px at 34% 72%, #4cd9e8 50%, transparent 50%),
        radial-gradient(1.5px 1.5px at 80% 66%, #ffd166 50%, transparent 50%),
        radial-gradient(1.5px 1.5px at 56% 44%, #b06cff 50%, transparent 50%),
        radial-gradient(1.5px 1.5px at 14% 54%, #72eb67 50%, transparent 50%);
      font-family: var(--serif); font-size: .95rem;
      color: rgba(255,255,255,.55);
      transition: border-color .45s ease, color .45s ease, box-shadow .45s ease;
    }
    .checklist li.in::before {
      border-color: var(--accent);
      color: #fff;
      box-shadow: 0 0 0 6px var(--accent-wash);
    }

    /* Connector, drawn downward as the step activates. */
    .checklist li:not(:last-child)::after {
      content: ""; position: absolute; left: 1.05rem; top: 2.15rem; bottom: .6rem;
      width: 1px; background: var(--rule);
      transform: scaleY(0); transform-origin: top;
      transition: transform .7s ease .1s;
    }
    .checklist li.in::after { transform: scaleY(1); }

    @media (prefers-reduced-motion: reduce) {
      #stars, #stars2, #stars3,
      #hstars, #hstars2, #hstars3 { animation: none !important; }
      .neon-checkbox__borders span,
      .neon-checkbox__particles span,
      .neon-checkbox__rings .ring,
      .neon-checkbox__sparks span { animation: none !important; }
      .switch:hover .ch:not(:checked) + .slider:before { animation: none !important; }
      .checklist li { opacity: 1; transform: none; }
      .checklist li::after { transform: scaleY(1); }
    }

    /* ---- Tooltips ---- */
    .field-head { display: flex; align-items: center; gap: .4rem; margin-bottom: .5rem; }
    .field-head label { margin-bottom: 0; }

    .tip {
      position: relative;
      display: inline-flex;
      width: .95rem; height: .95rem;
      color: var(--muted);
      cursor: help;
      border-radius: 50%;
    }
    .tip svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; }
    .tip:hover, .tip:focus-visible { color: var(--accent); outline: none; }

    .tip-body {
      position: absolute;
      bottom: calc(100% + .55rem);
      left: 50%;
      transform: translateX(-50%) translateY(.25rem);
      z-index: 5;
      width: max-content; max-width: 17rem;
      padding: .6rem .75rem;
      background: var(--ink);
      color: #fff;
      font-family: var(--sans);
      font-size: .78rem; line-height: 1.45; letter-spacing: 0;
      border-radius: 6px;
      box-shadow: 0 6px 20px rgba(23,23,26,.18);
      opacity: 0; visibility: hidden;
      transition: opacity .18s ease, transform .18s ease, visibility .18s;
    }
    /* Little pointer down to the icon. */
    .tip-body::after {
      content: "";
      position: absolute; top: 100%; left: 50%;
      margin-left: -5px;
      border: 5px solid transparent;
      border-top-color: var(--ink);
    }
    .tip-body code { background: rgba(255,255,255,.14); padding: 0 .25rem; border-radius: 3px; }

    /* Shown on hover and on keyboard focus, so it is not pointer only. */
    .tip:hover .tip-body,
    .tip:focus-visible .tip-body {
      opacity: 1; visibility: visible;
      transform: translateX(-50%) translateY(0);
    }

    /* Near the left edge the bubble would overflow; nudge the first one in. */
    @media (max-width: 40rem) {
      .tip-body { left: 0; transform: translateX(0) translateY(.25rem); }
      .tip-body::after { left: .5rem; }
      .tip:hover .tip-body, .tip:focus-visible .tip-body { transform: translateX(0) translateY(0); }
    }

    /* ---- Form ---- */
    form { margin-top: 3rem; }

    .field { margin-bottom: 1.75rem; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 40rem) { .grid { grid-template-columns: 1fr; } }

    fieldset { border: 0; padding: 0; margin: 0 0 1.75rem; }
    legend {
      padding: 0;
      font-size: .8rem; letter-spacing: .04em;
      color: var(--muted);
      margin-bottom: .5rem;
    }

    label {
      display: block;
      font-size: .8rem; letter-spacing: .04em;
      color: var(--muted);
      margin-bottom: .5rem;
    }
    label.required::after { content: "*"; color: var(--danger); margin-left: .25rem; }

    input[type="email"], input[type="text"] {
      width: 100%;
      padding: .8rem 0;
      border: 0; border-bottom: 1px solid var(--rule);
      background: transparent;
      font-family: var(--mono); font-size: .95rem;
      color: var(--ink);
      transition: border-color .2s ease;
    }
    input::placeholder { color: #b9b6b0; }
    input[type="email"]:focus, input[type="text"]:focus {
      outline: none;
      border-bottom-color: var(--accent);
    }
    input:disabled { color: #b9b6b0; border-bottom-style: dashed; }

    /* Toggle. The hidden input before it supplies the unchecked value, so
       the form still posts journal=True or journal=False without JavaScript. */
    .switch {
      font-size: 17px;
      position:  relative;
      display: inline-block;
      width: 3.5em;
      height: 1.5em;
    }
    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background-color: #ccc;
      transition: 0.4s;
      border-radius: 1rem 0rem 1rem;
    }
    .slider:before {
      position: absolute;
      content: "";
      height: 1.5em;
      width: 1.4em;
      left: 0em;
      bottom: 0em;
      background-color: white;
      transition: 0.4s;
      border-radius: 1rem 0rem 1rem;
      border: 3px solid white;
    }
    .ch:checked + .slider {
      background-color: #72eb67;
    }

    /* Hover affordance. Only while off, where it is least obvious that this
       is interactive. Once on, the travelled knob speaks for itself. */
    .switch:hover .slider { background-color: #b9b9b9; }
    .switch:hover .ch:not(:checked) + .slider:before {
      animation: nudge 0.9s ease-in-out infinite;
    }
    @keyframes nudge {
      0%, 100% { transform: translateX(0)      rotate(0deg); }
      45%      { transform: translateX(0.45em) rotate(-8deg); }
    }
    .ch:focus + .slider {
      box-shadow: 0 0 1px #2196f3;
    }
    .ch:checked + .slider:before {
      transform: translateX(2.2em);
      background-color: green;
      box-shadow: 0px 0px 40px 5px #72eb67;
      border: 3px solid white;
    }
    .ch:checked + .slider::after {
      content: "|";
      color: white;
      position: absolute;
      right: 0.3rem;
      top: -3.3px;
      transform: rotate(45deg);
    }

