  <main class="page">

    <div class="hero-band">
      <div id="hstars" aria-hidden="true"></div>
      <div id="hstars2" aria-hidden="true"></div>
      <div id="hstars3" aria-hidden="true"></div>
      <div class="hero-inner">
        <img class="mark rise d1"
             src="https://raw.githubusercontent.com/neurolibre/brand/main/png/preview_magn.png"
             alt="NeuroLibre">
      </div>
    </div>

    <h1 class="rise d2">Build a <em>living</em> preprint.</h1>

    <p class="standfirst rise d2">
      Reproducible, executable publications built straight from your repository.
      Run a preview build before you submit.
    </p>

    <hr class="rule rise d3">

    <p class="section-label rise d3">Before you build</p>

    <ol class="checklist rise d3">
      <li>
        Structure your GitHub repository according to the
        <a href="https://docs.neurolibre.org/en/latest/STRUCTURE.html" target="_blank" rel="noopener">NeuroLibre guidelines</a>.
        Not there yet? Start from the
        <a href="https://evidencepub.io/templates" target="_blank" rel="noopener">template gallery</a>.
      </li>
      <li>
        If your preprint needs data,
        <a href="https://github.com/neurolibre/info/issues/new?assignees=agahkarakuzu&labels=DOWNLOAD&projects=&template=data_cache.md&title=" target="_blank" rel="noopener">open an issue</a>
        so we can cache it for you.
      </li>
      <li>
        If your preprint is executable, confirm a successful
        <a href="https://terrarium.evidencepub.io" target="_blank" rel="noopener">terrarium</a> build for your repository.
      </li>
    </ol>

    <form id="preview-form" action="/neurolibre" accept-charset="UTF-8" method="post" class="rise d5">

      <div class="field grid">
        <div>
        <div class="field-head">
          <label for="email" class="required">Email address</label>
          <span class="tip" tabindex="0" role="button" aria-label="More information" aria-describedby="tip-email">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7"/><path d="M8 7v4.2M8 4.6v.9"/></svg>
            <span class="tip-body" id="tip-email" role="tooltip">Where build notifications are sent.</span>
          </span>
        </div>
          <input placeholder="user@mail.com" type="email" name="email" id="email" required />
        </div>
        <div>
        <div class="field-head">
          <label for="repository" class="required">Preprint repository</label>
          <span class="tip" tabindex="0" role="button" aria-label="More information" aria-describedby="tip-repo">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7"/><path d="M8 7v4.2M8 4.6v.9"/></svg>
            <span class="tip-body" id="tip-repo" role="tooltip">Your GitHub repository, in full or as <code>owner/name</code>.</span>
          </span>
        </div>
          <input placeholder="neurolibre/mystical-article" type="text" name="repository" id="repository" required />
        </div>
      </div>

      <div class="field">
        <div class="field-head">
          <label for="branch">Binder commit ref</label>
          <span class="tip" tabindex="0" role="button" aria-label="More information" aria-describedby="tip-branch">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7"/><path d="M8 7v4.2M8 4.6v.9"/></svg>
            <span class="tip-body" id="tip-branch" role="tooltip">Only used with a custom runtime. Defaults to the commit hash of your most recent successful terrarium build.</span>
          </span>
        </div>
        <input placeholder="latest (default)" type="text" name="branch" id="branch" disabled />
      </div>

      <fieldset class="runtime-band" aria-label="Reproducible runtime">
        <div id="stars" aria-hidden="true"></div>
        <div id="stars2" aria-hidden="true"></div>
        <div id="stars3" aria-hidden="true"></div>

        <div class="band-inner">
        <p class="band-label">Reproducible runtime</p>

        <input type="hidden" name="journal" value="False">
        <label class="switch">
          <input class="ch" type="checkbox" name="journal" id="nlnb" value="True"
                 aria-describedby="journal-state" />
          <span class="slider"></span>
        </label>

        <p class="toggle-state" id="journal-state">My preprint does not need a custom runtime environment</p>

        <div class="terrarium" id="terrarium-gate">
          <!-- No name attributes here: these are client side gates, never submitted. -->
          <div class="gate-row">
          <label class="neon-checkbox">
            <input type="checkbox" id="binder-folder">
            <div class="neon-checkbox__frame">
              <div class="neon-checkbox__box">
                <div class="neon-checkbox__check-container">
                  <svg viewBox="0 0 24 24" class="neon-checkbox__check" aria-hidden="true">
                    <path d="M3,12.5l7,7L21,5"></path>
                  </svg>
                </div>
                <div class="neon-checkbox__glow"></div>
                <div class="neon-checkbox__borders">
                  <span></span><span></span><span></span><span></span>
                </div>
              </div>
              <div class="neon-checkbox__effects">
                <div class="neon-checkbox__particles">
                  <span></span><span></span><span></span><span></span><span></span><span></span>
                  <span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
                <div class="neon-checkbox__rings">
                  <div class="ring"></div><div class="ring"></div><div class="ring"></div>
                </div>
                <div class="neon-checkbox__sparks">
                  <span></span><span></span><span></span><span></span>
                </div>
              </div>
            </div>
          </label>
            <label class="gate-text" for="binder-folder">I have created a <code>binder</code> folder to specify dependencies for my preprint</label>
          </div>
          <div class="gate-row">
          <label class="neon-checkbox">
            <input type="checkbox" id="terrarium-built">
            <div class="neon-checkbox__frame">
              <div class="neon-checkbox__box">
                <div class="neon-checkbox__check-container">
                  <svg viewBox="0 0 24 24" class="neon-checkbox__check" aria-hidden="true">
                    <path d="M3,12.5l7,7L21,5"></path>
                  </svg>
                </div>
                <div class="neon-checkbox__glow"></div>
                <div class="neon-checkbox__borders">
                  <span></span><span></span><span></span><span></span>
                </div>
              </div>
              <div class="neon-checkbox__effects">
                <div class="neon-checkbox__particles">
                  <span></span><span></span><span></span><span></span><span></span><span></span>
                  <span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
                <div class="neon-checkbox__rings">
                  <div class="ring"></div><div class="ring"></div><div class="ring"></div>
                </div>
                <div class="neon-checkbox__sparks">
                  <span></span><span></span><span></span><span></span>
                </div>
              </div>
            </div>
          </label>
            <label class="gate-text" for="terrarium-built">I have built a runtime at <a href="https://terrarium.evidencepub.io" target="_blank" rel="noopener">terrarium.evidencepub.io</a></label>
          </div>

          <div class="gate-hint" id="terrarium-hint" role="note">
            <p>Build it once. The same runtime is reused for every preview of your
               preprint, so you only need a new one when your dependencies change.</p>
          </div>
          <p class="gate-note" id="gate-note">Confirm both to enable the build.</p>
        </div>
        </div>
      </fieldset>

